# Copier ce fichier en .env et compléter. Le fichier .env n'est JAMAIS commité.

# Client ID OAuth Google (console.cloud.google.com > Identifiants)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# "sub" Google des super-admins, séparés par des virgules
SUPER_ADMIN_SUBS=

# Base de données (valeurs locales par défaut)
DB_USER=snap
DB_PASSWORD=snap
DB_NAME=snapwedding

# Stockage S3 / RustFS (valeurs locales par défaut)
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin

# URL publique du front, encodée dans le QR code
PUBLIC_BASE_URL=http://localhost:5173
